# 环境变量模板（A3）。复制为 .env 后填写；.env 已被 .gitignore 忽略，禁止入库。
# 开发环境可全部留空（使用 docker-compose.yml 中的开发默认值）；
# 生产环境必须全部覆盖，并启用 SPRING_PROFILES_ACTIVE=prod。

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=safetrans

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 对象存储 ----
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---- JWT（生产必须设置，长度 ≥ 32 字节，随机生成）----
JWT_SECRET=

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=
