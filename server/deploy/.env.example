# 环境变量模板（A3 建立，E1 扩展）。
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，禁止入库。
# 开发环境可全部留空（使用 docker-compose.yml 中的开发默认值）；
# 生产编排 docker-compose.prod.yml 中所有带 :? 的变量缺失即启动失败。
#
# 生成强随机值：openssl rand -hex 24

# ---- 数据库（生产禁止用 root 作为应用连接账号）----
MYSQL_ROOT_PASSWORD=
MYSQL_USER=safetrans_app
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=safetrans

# ---- Redis（生产强制 requirepass）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 对象存储 ----
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ---- JWT（生产必须设置，长度 ≥ 32 字节，随机生成）----
JWT_SECRET=

# ---- Spring profile（生产编排已强制设为 prod，此处仅供开发栈使用）----
SPRING_PROFILES_ACTIVE=

# ============ E1 生产运维新增 ============

# ---- 域名与镜像 ----
DOMAIN=localhost
IMAGE_TAG=latest

# ---- 编排文件（monitor / backup / restore 默认读它）----
COMPOSE_FILE=docker-compose.prod.yml
# 生产栈 backend 不暴露 8080，恢复脚本的健康探测须经 frontend HTTPS
HEALTH_URL=https://localhost/health
HEALTH_CURL_OPTS=-k            # 自签证书演练用 -k；真实证书改为空

# ---- 监控告警 ----
# 留空则只写本地日志 monitor/alerts.log；生产必须配置
ALERT_WEBHOOK=
ALERT_WEBHOOK_TYPE=generic      # wecom | dingtalk | feishu | generic
MONITOR_BASE_URL=https://localhost
CURL_INSECURE=-k                # 自签证书演练用 -k；真实证书改为空
DISK_WARN_PERCENT=85
BACKUP_MAX_AGE_HOURS=30
CERT_WARN_DAYS=14
RESTART_WARN_COUNT=5
START_GRACE_SECONDS=60      # 发版/备份重启后健康检查宽限期，避免误告警

# ---- 备份策略 ----
BACKUP_RETENTION_DAYS=14
BACKUP_COLD=--cold              # 冷备（低峰）；改空则热备
# 异地同步钩子，接收备份目录为 $1，例如：
#   BACKUP_REMOTE_HOOK="rclone copy --s3-provider=... "
#   BACKUP_REMOTE_HOOK="aws s3 cp --recursive"
BACKUP_REMOTE_HOOK=
